# ============================================================
# RFX20 Predictor — .gitignore
# ============================================================

# --- Project data and outputs ---
# Raw data is tracked (irreproducible: Primary S.A. API + manual macro files)
# Derived/generated layers are excluded
data/processed/
data/features/
data/*.duckdb
results/

# MLflow local tracking backend (Fase 3+, model experiment runs)
# mlruns.db = SQLite tracking store (from MLflow 3.15 on, mlruns/ file store
# is in maintenance mode). mlruns/ kept ignored too in case older runs exist.
mlruns.db
mlruns/

# --- Environment and secrets ---
.env
.envrc

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
*.egg
MANIFEST
dist/
build/
.eggs/
wheels/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- OS ---
.DS_Store
Thumbs.db

# --- Tools ---
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
*.log

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- uv ---
# uv.lock is intentionally kept in version control for reproducibility.
# Uncomment the next line only if this is a library (not an application).
# uv.lock
